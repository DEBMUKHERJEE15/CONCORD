# Google Gen AI Gemma API Key (server-side only)
GEMMA_API_KEY=
# Hosted Gemma model identifier (defaults to gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# OpenStreetMap Overpass API Endpoint (defaults to public endpoint if unset)
OVERPASS_API_ENDPOINT=https://overpass-api.de/api/interpreter

# Optional Live Hotel Rates via Amadeus Self-Service APIs
# Documentation: https://developers.amadeus.com/self-service/apis-docs/guides/developer-guides/resources/hotels/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
